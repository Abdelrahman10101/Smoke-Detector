# Smoking Detection Service Environment Variables

# Runtime & Device
REQUIRE_GPU=0
ORT_THREADS=4

# Detection & Model Config
DET_CONF=0.35
DET_IMGSZ=640
SMOKING_THRESHOLD=0.50
CROP_MODE=person
CROP_MARGIN=0.10
MIN_CROP_PX=64
MAX_PERSONS=10

# Temporal Voting & Alerts
VOTE_K=3
VOTE_N=5
CLS_STRIDE=3
COOLDOWN_S=60.0

# Performance & Streaming
PROCESS_FPS=5.0
MAX_SESSIONS=2
MOTION_GATE=1
CCTV_SIM=0

# Storage & Folders
VIDEOS_DIR=data/videos
UPLOADS_DIR=data/uploads
EVENTS_DIR=data/events
MAX_UPLOAD_MB=500
SNAPSHOT_RETENTION_DAYS=7
